layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                // --- ANSI Color Index Definitions ---
                // Maps variables directly to terminal-defined theme colors
                color_bg         "0"   // Terminal Background (Dark/Black)
                color_bg_bright  "8"   // Terminal Bright Background (Gray/Subtle)
                color_fg         "7"   // Terminal Main Foreground (White/Light gray)
                color_fg_bright  "15"  // Terminal Bright Foreground (Pure White)
                color_accent     "4"   // Terminal Primary Accent (Standard Blue)
                color_critical   "1"   // Terminal Alert Color (Standard Red)
                color_success    "2"   // Terminal Success Color (Standard Green)
                color_warn       "3"   // Terminal Warning Color (Standard Yellow)
                color_info       "6"   // Terminal Secondary Accent (Standard Cyan)
                color_locked     "5"   // Terminal System Accent (Standard Magenta)

                // Render structure referencing variables using '$'
                format_left  "{mode}#[bg=$bg,fg=$success,bold] {session} {tabs}"
                format_right "{datetime}"
                format_space "#[bg=$bg]"

                // Mode setups using aliases
                mode_normal       "#[bg=$info] "
                mode_locked       "#[fg=$bg,bg=$locked] 󰌾  {name} "
                mode_pane         "#[fg=$bg,bg=$critical] 󱏂  {name} "
                mode_tab          "#[fg=$bg,bg=$critical] 󱂬  {name} "
                mode_session      "#[fg=$bg,bg=$locked] 󰨣  {name} "
                mode_resize       "#[fg=$bg,bg=$success] 󰩨  {name} "
                mode_scroll       "#[fg=$bg,bg=$success] 󰦨  {name} "
                mode_enter_search "#[fg=$bg,bg=$success] 󱎸 󰏫  {name} "
                mode_search       "#[fg=$bg,bg=$success] 󱎸  {name} "

                // Datetime panel with dimmed background contrast
                datetime          "#[bg=$bg_bright,fg=$fg] {format} "
                datetime_format   "%A, %d %b %Y %H:%M"
                datetime_timezone "Asia/Singapore"

                // Unselected and active tabs using index mapping
                tab_normal   "#[fg=$fg,bg=$bg_bright,bold,italic] {index} #[fg=$fg,bg=$bg,bold,italic] {name} "
                tab_active   "#[fg=$bg,bg=$accent,bold] {index} #[fg=$fg_bright,bg=$bg,bold] {name} "
            }
        }
    }
}
